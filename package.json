{
  "name": "crm-readonly-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server that lets an AI assistant work with CRM data safely: guarded SQL, PII masking, audit log",
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc",
    "seed": "node dist/seed.js data/demo.db",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "crm-readonly-mcp": "dist/index.js"
  }
}
